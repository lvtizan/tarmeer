{
  "name": "tarmeer-server",
  "version": "1.1.0",
  "description": "Tarmeer 4.0 Backend Server with Enhanced Security",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon src/app.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/app.js",
    "test": "npm run build && node --test dist/lib/*.test.js",
    "test:smoke:public": "npm run build && node scripts/smoke-public-api.js",
    "migrate:project-images": "ts-node scripts/migrate-project-images-to-files.ts",
    "generate-jwt": "ts-node scripts/generate-jwt-secret.ts",
    "validate-config": "ts-node -e \"import('./dist/lib/jwtManager').then(m => m.validateJWTConfig())\""
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.5",
    "@google/generative-ai": "^0.24.1",
    "@types/cheerio": "^0.22.35",
    "@types/multer": "^2.1.0",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.19.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "https-proxy-agent": "^8.0.0",
    "iconv-lite": "^0.7.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "sharp": "^0.34.5",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
