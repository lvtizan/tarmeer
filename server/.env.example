# Copy to .env and adjust. For local dev use PORT=3001, NODE_ENV=development.
# Database (local or Aliyun RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=tarmeer

# Aliyun RDS example (Dubai):
# DB_HOST=rm-eb3t6y5093m91i2wzqo.mysql.dubai.rds.aliyuncs.com
# DB_PORT=3306
# DB_USER=tarmeerCRM
# DB_PASSWORD=your_rds_password
# DB_NAME=tarmeer

# JWT 配置
# ⚠️ 安全提示：生产环境必须使用强密钥（至少32字符，建议64字符以上）
# 生成安全密钥的方法：
# 1. Node.js: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 2. OpenSSL: openssl rand -hex 64
# 3. 在线工具: https://www.uuidgenerator.net/api/guid
JWT_SECRET=your_jwt_secret_here_change_in_production

# JWT 密钥轮换（可选，用于提高安全性）
# JWT_ROTATION_ENABLED=false
# JWT_ROTATION_INTERVAL=30d

# SMTP（阿里云邮件推送，与公司 Spring 配置一致）
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@mail.kptom.com
SMTP_PASS=your_aliyun_smtp_password
SMTP_FROM=noreply@mail.kptom.com
SMTP_FROM_NAME=Tarmeer
SMTP_REPLY_TO=support@tarmeer.com
SMTP_RETURN_PATH=bounces@mail.kptom.com

# 服务器配置（生产环境建议 PORT=3002，与 Nginx 代理一致）
PORT=3002
NODE_ENV=production

# 前端配置（生产环境改为站点域名，如 http://47.91.108.104）
FRONTEND_URL=http://47.91.108.104

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/callback/google

# AI Image Tagging (Gemini Vision)
GOOGLE_VISION_ENABLED=false
GEMINI_API_KEY=                                           # Gemini API Key 字符串

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:5173/api/auth/callback/facebook
