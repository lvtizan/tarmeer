{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "S=/tmp/tarmeer-pitfall-shown; [ -f \"$S\" ] && exit 0; touch \"$S\"; P=$(awk '/^## 写代码前必读清单/{f=1;next} f&&/^## /{exit} f{print}' /Users/kp/.claude/projects/-Users-kp-Code-tarmeer-4-0-local/memory/MEMORY.md 2>/dev/null | head -60); [ -z \"$P\" ] && exit 0; jq -cn --arg p \"$P\" '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":(\"⚠️ 写代码前必读（本 session 首次提醒）：\\n\" + $p)}}'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' 2>/dev/null | grep -qE '(src/|server/src/).*[.](ts|tsx|js)$' && touch /tmp/tarmeer-check-needed || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/kp/Code/tarmeer-4.0-local/scripts/harness/stop-hook.sh",
            "timeout": 60,
            "asyncRewake": true,
            "statusMessage": "Running tsc check..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(lsof:*)",
      "Bash(pkill -f \"npm run dev\")",
      "Bash(timeout 90 npx playwright test --reporter=line)",
      "Bash(./node_modules/.bin/playwright test:*)",
      "Bash(pkill -f \"vite\")",
      "Bash(pkill:*)",
      "Bash(chmod:*)",
      "Bash(wc -l tests/project-upload*.spec.ts tests/test-upload.spec.ts)",
      "Bash(du -sh tests/*)",
      "Bash(mysql:*)",
      "Bash(node -e \":*)",
      "Bash(SECRET=\"dev_jwt_secret_min_32_chars_for_local_testing_only\" node -e \":*)",
      "Bash(node -e \"const jwt = require\\(''jsonwebtoken''\\); const token = jwt.sign\\({ id: 2067, email: ''lvyiming@kp99.cn'' }, ''dev_jwt_secret_min_32_chars_for_local_testing_only'', { expiresIn: ''24h'' }\\); console.log\\(token\\);\")",
