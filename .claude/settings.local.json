      "Bash(bash scripts/qa-smoke.sh)",
      "Bash(DEPLOY_RULES_ACK=YES bash deploy-simple.sh)",
      "Bash(DEPLOY_RULES_ACK=YES DEPLOY_SSH_KEY=~/.ssh/tarmeer_ecs bash deploy-simple.sh)",
      "Bash(ssh:*)",
      "Bash(./node_modules/.bin/tsc)",
