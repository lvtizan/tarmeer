{
  "name": "tarmeer-5.0",
  "private": true,
  "version": "5.10.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node -e \"const{spawn}=require('child_process');const b=spawn('npm',['run','dev'],{cwd:'server',stdio:'inherit',shell:true});const f=spawn('npm',['run','dev'],{stdio:'inherit',shell:true});process.on('SIGINT',()=>{b.kill();f.kill();process.exit()})\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "bash deploy.config.sh",
    "audit:images": "node scripts/audit-images.mjs",
    "qa:smoke": "bash scripts/qa-smoke.sh",
    "backend:up": "bash scripts/backend-up.sh",
    "backend:health": "bash scripts/backend-health-check.sh",
    "lint:reliability": "node scripts/harness/lint-reliability.mjs",
    "lint:cors": "node scripts/harness/lint-cors-nginx.mjs",
    "lint:docs": "node scripts/harness/lint-docs-freshness.mjs",
    "smoke:prod": "node scripts/harness/smoke-production.mjs",
    "predeploy:gate": "bash scripts/harness/pre-deploy-gate.sh"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@xenova/transformers": "^2.17.2",
    "framer-motion": "^12.0.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "playwright": "^1.58.2",
    "puppeteer": "^24.39.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
